        <mxCell id="9-vQshF-ZVKh4zI0uL3I-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" value="&lt;div style=&quot;text-align: left;&quot;&gt;• &lt;b&gt;Input:&lt;/b&gt; &quot;issue_desc&quot; – mô tả lỗi của khách hàng.&lt;br&gt;• &lt;b&gt;TF-IDF:&lt;/b&gt; ngram (1,2), min_df=2, max_features=20000.&lt;br&gt;• &lt;b&gt;Output:&lt;/b&gt; &quot;issue_category&quot; – nhóm sự cố và độ tin cậy.&lt;/div&gt;" vertex="1">
