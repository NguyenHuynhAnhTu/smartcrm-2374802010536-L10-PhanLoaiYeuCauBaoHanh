        <mxCell id="9-vQshF-ZVKh4zI0uL3I-18" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" value="&lt;b&gt;THÔNG TIN DATASET&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="300" x="810" y="440" as="geometry" />
        </mxCell>
        <mxCell id="9-vQshF-ZVKh4zI0uL3I-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;spacingRight=10;" value="&lt;div style=&quot;text-align: left;&quot;&gt;• &lt;b&gt;File:&lt;/b&gt; &quot;issue_descriptions.csv&quot;&lt;br&gt;• &lt;b&gt;Số mẫu:&lt;/b&gt; 4.000 mẫu&lt;br&gt;• &lt;b&gt;Chia dữ liệu:&lt;/b&gt; Train 70% / Validation 15% / Test 15%&lt;br&gt;• &lt;b&gt;Phương pháp:&lt;/b&gt; Stratified, &quot;random_state=42&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="450" x="810" y="470" as="geometry" />
        </mxCell>
        <mxCell id="9-vQshF-ZVKh4zI0uL3I-20" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" value="&lt;b&gt;GHI CHÚ QUAN TRỌNG&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="300" x="310" y="580" as="geometry" />
