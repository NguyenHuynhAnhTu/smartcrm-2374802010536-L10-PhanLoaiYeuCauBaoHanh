        <mxCell id="9-vQshF-ZVKh4zI0uL3I-16" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" value="&lt;b&gt;CẤU TRÚC DỮ LIỆU (SCHEMA)&lt;/b&gt;" vertex="1">
